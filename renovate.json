{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "ansible-core 2.21 crashes on Python 3.15, remove once ansible-core 2.22 is GA",
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions declared with a renovate comment in Dockerfiles",
      "managerFilePatterns": ["/(^|/)Dockerfile[^/]*$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s+ENV [A-Z_]+_VERSION=(?:\\$\\{[A-Z_]+:-)?\"?(?<currentValue>[^\"}\\s]+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}
